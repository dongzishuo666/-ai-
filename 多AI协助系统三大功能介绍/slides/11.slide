                <text x='48' y='88' fontSize='19' fontWeight='bold' fill='#0B2545'>大纲生成</text>
                <text x='48' y='112' fontSize='13' fill='#64748B'>建议标题 + 3-5 章节 + 每章 2-3 要点</text>
                <line x1='220' y1='128' x2='220' y2='152' stroke='#2E7CF6' strokeWidth='2.5' />
                <polygon points='214,150 226,150 220,160' fill='#2E7CF6' />
                <rect x='20' y='164' width='400' height='104' rx='12' fill='#FFFFFF' stroke='#2E7CF6' strokeWidth='2' />
                <text x='48' y='198' fontSize='13' fontWeight='bold' fill='#2E7CF6'>第二棒 · 中转渠道</text>
                <text x='48' y='228' fontSize='19' fontWeight='bold' fill='#0B2545'>初稿撰写</text>
