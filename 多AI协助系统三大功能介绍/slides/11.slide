                <line x1='220' y1='268' x2='220' y2='292' stroke='#2E7CF6' strokeWidth='2.5' />
                <polygon points='214,290 226,290 220,300' fill='#2E7CF6' />
                <rect x='20' y='304' width='400' height='104' rx='12' fill='rgba(0,201,167,0.10)' stroke='#00C9A7' strokeWidth='3' />
                <text x='48' y='338' fontSize='13' fontWeight='bold' fill='#00A88C'>第三棒 · 官方渠道 + 裁决校验</text>
                <text x='48' y='368' fontSize='19' fontWeight='bold' fill='#0B2545'>定稿审核</text>
                <text x='48' y='392' fontSize='13' fill='#0B7A68'>校验结构 · 优化表达 · 统一风格 · 控制篇幅</text>
                <line x1='420' y1='356' x2='452' y2='356' stroke='#64748B' strokeWidth='2' strokeDasharray='5 4' />
                <polygon points='450,350 462,356 450,362' fill='#64748B' />
                <rect x='458' y='304' width='172' height='104' rx='10' fill='#FFFFFF' stroke='#64748B' strokeWidth='1.5' strokeDasharray='6 4' />
                <text x='478' y='338' fontSize='15' fontWeight='bold' fill='#0B2545'>修改迭代</text>
