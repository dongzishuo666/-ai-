    <Box style={{ flexDirection: 'row', gap: 26, height: 520, marginTop: 12 }}>
        <Box style={{ width: 690, height: 520, borderRadius: 16, background: '#F4F7FB', padding: 20, justifyContent: 'center', alignItems: 'center' }}>
            <svg width={650} height={476} viewBox='0 0 650 476'>
                <rect x='20' y='24' width='400' height='104' rx='12' fill='#FFFFFF' stroke='#2E7CF6' strokeWidth='2' />
