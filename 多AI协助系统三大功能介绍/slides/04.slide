<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '20px 64px' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, height: 100 }}>
        <Box style={{ width: 4, height: 40, background: '#0B2545' }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0B2545' }}>核心设计哲学：四段式校验链路</Text>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 28, height: 520, marginTop: 12 }}>
        <Box style={{ width: 690, height: 520, borderRadius: 16, background: '#F4F7FB', padding: 24, justifyContent: 'center', alignItems: 'center' }}>
            <svg width={642} height={466} viewBox='0 0 642 466'>
                <rect x='10' y='6' width='622' height='88' rx='10' fill='#FFFFFF' stroke='#2E7CF6' strokeWidth='2' />
                <text x='38' y='42' fontSize='21' fontWeight='bold' fill='#0B2545'>前置处理</text>
                <text x='38' y='72' fontSize='14.5' fill='#64748B'>识别文档类型 · 解析用户需求 · 生成结构化需求单</text>
                <line x1='321' y1='94' x2='321' y2='112' stroke='#2E7CF6' strokeWidth='2.5' />
                <polygon points='315,110 327,110 321,120' fill='#2E7CF6' />
                <rect x='10' y='122' width='622' height='88' rx='10' fill='#FFFFFF' stroke='#2E7CF6' strokeWidth='2' />
                <text x='38' y='158' fontSize='21' fontWeight='bold' fill='#0B2545'>分层生成</text>
                <text x='38' y='188' fontSize='14.5' fill='#64748B'>多角色 AI 固定串行接力 · 逐级迭代优化</text>
                <line x1='321' y1='210' x2='321' y2='228' stroke='#2E7CF6' strokeWidth='2.5' />
                <polygon points='315,226 327,226 321,236' fill='#2E7CF6' />
                <rect x='10' y='238' width='622' height='88' rx='10' fill='rgba(0,201,167,0.10)' stroke='#00C9A7' strokeWidth='3' />
                <text x='38' y='274' fontSize='21' fontWeight='bold' fill='#0B2545'>多数裁决</text>
                <text x='38' y='304' fontSize='14.5' fill='#0B7A68'>裁判校验 · 共识判定 · 不合格即修正后输出</text>
                <line x1='321' y1='326' x2='321' y2='344' stroke='#2E7CF6' strokeWidth='2.5' />
                <polygon points='315,342 327,342 321,352' fill='#2E7CF6' />
                <rect x='10' y='354' width='622' height='88' rx='10' fill='#FFFFFF' stroke='#2E7CF6' strokeWidth='2' />
                <text x='38' y='390' fontSize='21' fontWeight='bold' fill='#0B2545'>后置纠偏</text>
                <text x='38' y='420' fontSize='14.5' fill='#64748B'>异常重写 · 降级兜底 · 保障稳定输出</text>
            </svg>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 20 }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0B2545' }}>质量来自流程，不来自模型</Text>
            <Text style={{ fontSize: 17, color: '#14202E', lineHeight: 1.7 }}>
                全系统贯彻「不信任单一 AI，凡事走程序校验」的原则：每一环产出都必须经过下一环复核，多数裁决与后置纠偏兜住单模型的随机性——8 个模型不是越多越好，而是让每个结论都有程序背书。
            </Text>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <FAIcon name='cubes' style={{ fill: '#2E7CF6', width: 26, height: 26 }} />
                <Text style={{ fontSize: 16, color: '#14202E', lineHeight: 1.55 }}>架构统一：三大功能复用同一套调度与 API 管理</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <FAIcon name='route' style={{ fill: '#2E7CF6', width: 26, height: 26 }} />
                <Text style={{ fontSize: 16, color: '#14202E', lineHeight: 1.55 }}>逻辑同源：AI 角色固定串行，链路可复现、可回溯</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <FAIcon name='shield' style={{ fill: '#00C9A7', width: 26, height: 26 }} />
                <Text style={{ fontSize: 16, color: '#14202E', lineHeight: 1.55 }}>异常兜底：输出为空即重试，再失败降级备用 AI</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', height: 36, marginTop: 12 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>多AI协助系统 · 三大功能设计总方案</Text>
        <Text style={{ fontSize: 14, color: '#64748B' }}>04 / 14</Text>
    </Box>
</Slide>
