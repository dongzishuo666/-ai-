# ============================================================
# 多AI协同工作平台 · 后端环境配置
# 使用方法：把本文件复制一份并改名为 .env，然后填写密钥。
#          （.env 已被 .gitignore 忽略，不会被提交到代码库）
# 注意：等号两边不要加空格；值不需要加引号。
# ============================================================

# ------------------------------------------------------------
# 【一】AI 渠道密钥（★ 需要你填写的部分 ★）
# ------------------------------------------------------------

# ---- 渠道1：中转站（同时供应 4 个模型：openai / claude / gemini / grok）----
# 填写你的中转站 API 地址与密钥
RELAY_API_BASE_URL=https://your-relay-provider.com/v1
RELAY_API_KEY=

# ---- 渠道2：DeepSeek 官方 ----
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# ---- 渠道3：智谱 GLM 官方 ----
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=

# ---- 渠道4：文心一言 官方（需要 API Key + Secret Key 两个值）----
WENXIN_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat
WENXIN_API_KEY=
WENXIN_SECRET_KEY=

# ---- 渠道5：Kimi（月之暗面）官方 ----
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=

# ------------------------------------------------------------
# 【二】AI 调用参数（有默认值，一般不用改）
# ------------------------------------------------------------
# 最大并发调用数（轻量服务器建议 3）
AI_MAX_CONCURRENT=3
# 单次调用超时（秒）
AI_CALL_TIMEOUT=45
# 失败重试：基础延迟（秒）与倍率
AI_RETRY_DELAY_BASE=1.0
AI_RETRY_DELAY_MULTIPLIER=2.0
# 主模型失败时是否自动切换备用模型
AI_FALLBACK_ENABLED=true
# 备用模型也失败时是否跳过该步骤（true=跳过继续，false=任务失败）
AI_SKIP_ON_FAILURE=true

# ------------------------------------------------------------
# 【三】SSE 与讨论（有默认值，一般不用改）
# ------------------------------------------------------------
# SSE 心跳间隔（秒）
SSE_HEARTBEAT_INTERVAL=15
# 讨论暂停超时（秒，超时自动终止）
PAUSE_TIMEOUT_SECONDS=600

# ------------------------------------------------------------
# 【四】服务器（有默认值，一般不用改）
# ------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_TIMEOUT=300

# ------------------------------------------------------------
# 【五】其他（有默认值，一般不用改）
# ------------------------------------------------------------
# 上传文件大小上限（MB）
MAX_FILE_SIZE_MB=10
# 日志
LOG_RETENTION_DAYS=7
LOG_LEVEL=info
# CORS 允许来源（逗号分隔）。开发默认允许 Vite dev server；
# 生产部署时追加服务器 IP，例如：http://1.2.3.4,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
