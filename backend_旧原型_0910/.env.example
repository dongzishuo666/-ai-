# ===== 运行配置 =====
HOST=0.0.0.0
PORT=8000
# 强制使用本地模拟引擎（不需要任何 API Key 即可跑通全流程）
MOCK_MODE=false
# 单个 AI 请求超时（秒）与失败重试次数
REQUEST_TIMEOUT=60
MAX_RETRIES=1
# 上传限制与文档截断长度
MAX_UPLOAD_MB=20
MAX_DOC_CHARS=6000

# ===== 数据存储 =====
# DATA_DIR=./data

# ===== 渠道一：中转 API（Gemini / OpenAI / Claude / Grok）=====
# 若填写 RELAY_BASE_URL + RELAY_API_KEY，则中转渠道的模型统一走该聚合网关
RELAY_BASE_URL=
RELAY_API_KEY=

# ===== 渠道二：官方 API（DeepSeek / 智谱 / 文心一言 / Kimi）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

QIANFAN_API_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ===== 中转渠道单模型直连（未配置聚合网关时可选）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
